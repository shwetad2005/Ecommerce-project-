import com.study.backend.repositories.CartRepository;
import com.study.backend.repositories.UserRepository;
import com.study.backend.services.CartService;

public class CartServiceImpl implements CartService{

	@Autowired
	private UserRepository userRepository;
	
	@Autowired
	private CartRepository cartRepository;
	
	
	@Override
	public void addTocart(String userId, Integer productId) {
		// TODO Auto-generated method stub
		
	}

	@Override
	public Cart getCart(String userId) {
		// TODO Auto-generated method stub
		User user= userRepository.findById(userId)  
				.orElseThrow(()->new IdNotFoundException    // orElseThrow: will give user object
						("user with given id is not found")); 
		
		Cart cart = user.getCart();     // to fetch the cart 
		
		if (cart==null)
		{	
			cart = new Cart();      // cart object
			cart.setCartItems(new ArrayList<CartItem>());     // initialize the cart with array list
			cart.setUser(user);     // set for user
			
			cart = cartRepository.save(cart);
			
		}
		
		return cart;          // updated cart return
	}

}
